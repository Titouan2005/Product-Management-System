# Copy this file to .env.local and fill in your own PocketBase superuser details.
# .env.local is ignored by git, so your password is never committed.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SUPERUSER_EMAIL=your-email@example.com
POCKETBASE_SUPERUSER_PASSWORD=your-password

# Redis Cloud cache (homepage text). Find these in your Redis Cloud database
# page: Public endpoint = host:port, and the password of the "default" user.
REDIS_HOST=your-database.redis.io
REDIS_PORT=12345
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
